<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/managed_top_bar"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:background="#000000"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="28dp"
        android:visibility="gone">

        <com.dvid.dcam.app.ui.WifiSignalView
            android:id="@+id/managed_wifi_status"
            android:layout_width="28dp"
            android:layout_height="18dp"
            android:translationY="-1dp" />

        <com.dvid.dcam.app.ui.BatteryStatusView
            android:id="@+id/managed_battery_status"
            android:layout_width="36dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:translationY="1dp" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/custom_status_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_preview_message"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/custom_status_video_row"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_rec_dot" />
        </FrameLayout>

        <TextView
            android:id="@+id/custom_status_video_duration"
            style="@style/DcamStatusText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingTop="0dp"
            android:paddingEnd="0dp"
            android:paddingBottom="0dp"
            android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/custom_status_audio_row"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/audio_recording_status"
            android:src="@drawable/ic_mic_status" />

        <TextView
            android:id="@+id/custom_status_audio_duration"
            style="@style/DcamStatusText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
